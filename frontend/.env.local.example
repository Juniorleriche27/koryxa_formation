NEXT_PUBLIC_API_URL=https://api.formation.koryxa.fr
NEXT_PUBLIC_APP_URL=https://formation.koryxa.fr
NEXT_PUBLIC_FORMATION_PUBLIC_URL=https://formation.koryxa.fr
NEXT_PUBLIC_KORYXA_ADMIN_URL=https://admin.koryxa.fr
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# KORYXA Identity / Clerk — only required by the user-facing Formation frontend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.koryxa.fr/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.koryxa.fr/sign-up

# Shared HMAC bridge with the Formation backend callback.
KORYXA_IDENTITY_BRIDGE_KEY=replace-with-the-shared-koryxa-identity-bridge-key
KORYXA_FORMATION_IDENTITY_CALLBACK_URL=https://api.formation.koryxa.fr/access/koryxa-identity/callback
